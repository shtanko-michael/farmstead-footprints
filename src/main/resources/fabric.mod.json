{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Realistic footprints for players and mobs: pressed into snow, sand, mud, gravel and soil, lit like the ground around them, fading with time. Client-side.",
  "authors": ["Farmstead"],
  "contact": {
    "homepage": "${homepage}",
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "MIT",
  "icon": "assets/farmstead_footprints/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["online.farmsteadminecraft.footprints.platform.fabric.FootprintsFabric"],
    "client": ["online.farmsteadminecraft.footprints.platform.fabric.FootprintsFabricClient"],
    "modmenu": ["online.farmsteadminecraft.footprints.platform.fabric.FootprintsModMenu"]
  },
  "mixins": ["farmstead_footprints.mixins.json"],
  "accessWidener": "farmstead_footprints.ct",
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v0": "*",
    "fabric-command-api-v2": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
